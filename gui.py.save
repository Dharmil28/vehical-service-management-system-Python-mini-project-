import tkinter as tk
from tkinter import ttk, messagebox
from database import Database


class VehicleServiceApp:
    def __init__(self, root):
        self.root = root

    def vehicle_menu(self):
        window = tk.Toplevel(self.root)
        window.title("Vehicle Management")
        window.geometry("750x500")

        tk.Label(
            window,
            text="Vehicle Management",
            font=("Arial", 17, "bold")
        ).pack(pady=12)

        form = tk.Frame(window)
        form.pack(pady=8)

        fields = [
            ("Customer ID", "customer_id"),
            ("Registration Number", "registration"),
            ("Brand", "brand"),
            ("Model", "model")
        ]

        entries = {}

        for row, (label, key) in enumerate(fields):
            tk.Label(form, text=label + ":").grid(
                row=row, column=0, padx=8, pady=6, sticky="w"
            )
            entry = tk.Entry(form, width=32)
            entry.grid(row=row, column=1, padx=8, pady=6)
            entries[key] = entry

        columns = (
            "Vehicle ID", "Customer", "Registration", "Brand", "Model"
        )

        table = ttk.Treeview(
            window, columns=columns, show="headings", height=10
        )

        for column in columns:
            table.heading(column, text=column)
            table.column(column, width=135)

        table.pack(fill="both", expand=True, padx=10, pady=10)

        def load_vehicles():
            for item in table.get_children():
                table.delete(item)

            db = None
            cursor = None

            try:
                db = Database()
                cursor = db.get_connection().cursor()

                cursor.execute("""
                    SELECT v.vehicle_id, c.name,
                           v.registration_no, v.brand, v.model
                    FROM vehicles v
                    JOIN customers c
                    ON v.customer_id = c.customer_id
                    ORDER BY v.vehicle_id DESC
                """)

                for vehicle in cursor.fetchall():
                    table.insert("", tk.END, values=vehicle)

            except Exception as error:
                messagebox.showerror(
                    "Database Error", str(error), parent=window
                )
            finally:
                if cursor:
                    cursor.close()
                if db:
                    db.close()

        def add_vehicle():
            try:
                customer_id = int(
                    entries["customer_id"].get().strip()
                )
                registration = entries["registration"].get().strip()
                brand = entries["brand"].get().strip()
                model = entries["model"].get().strip()

                if not registration:
                    messagebox.showerror(
                        "Validation Error",
                        "Registration number is required.",
                        parent=window
                    )
                    return

                db = Database()
                connection = db.get_connection()
                cursor = connection.cursor()

                try:
                    cursor.execute("""
                        INSERT INTO vehicles
                        (customer_id, registration_no, brand, model)
                        VALUES (%s, %s, %s, %s)
                    """, (customer_id, registration, brand, model))

                    connection.commit()
                    vehicle_id = cursor.lastrowid

                except Exception:
                    connection.rollback()
                    raise

                finally:
                    cursor.close()
                    db.close()

                messagebox.showinfo(
                    "Success",
                    f"Vehicle registered!\nVehicle ID: {vehicle_id}",                    parent=window
                )

                for entry in entries.values():
                    entry.delete(0, tk.END)

                load_vehicles()

            except ValueError:
                messagebox.showerror(
                    "Invalid Input",
                    "Customer ID must be a number.",
                    parent=window
                )
            except Exception as error:
                messagebox.showerror(
                    "Error", str(error), parent=window
                )

        tk.Button(
            window,
            text="Register Vehicle",
            command=add_vehicle,
            width=20
        ).pack(pady=5)

      
